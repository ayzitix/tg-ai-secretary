{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-ai-secretary",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_AGENT", "class_name": "AccountAgent" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountAgent", "Registry"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "DELAY_MINUTES": "5",
    "OWNER_NAME": "Олексій",
    "PRESENCE_ENABLED": "false",
    "AWAY_DELAY_SECONDS": "15",
    "PRESENCE_TTL_SECONDS": "90",
    "HISTORY_TTL_DAYS": "7",
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "openai/gpt-oss-120b"
  }
}
