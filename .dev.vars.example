# Copy to .dev.vars for `wrangler dev`. Never commit real values.

TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string
GROQ_API_KEY=gsk_replace-with-your-key

# Display name the assistant uses for the owner.
OWNER_NAME=Your Name

# Your numeric Telegram id (send /start to @userinfobot to find it).
OWNER_TELEGRAM_ID=123456789

# Optional overrides of the values in wrangler.jsonc
# DELAY_MINUTES=10
# HISTORY_TTL_DAYS=7
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
